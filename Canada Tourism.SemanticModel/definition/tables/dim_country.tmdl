	partition dim_country = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        File.Contents(ProcessedFolder & "dim_country.csv"),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				
				    #"Use first row as headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				
				    // Keys and depth as whole numbers; is_balancing as true/false;
				    // the hierarchy levels as text
				    #"Set column types" = Table.TransformColumnTypes(
				        #"Use first row as headers",
				        {
				            {"member_id", Int64.Type},
				            {"name", type text},
				            {"parent_id", Int64.Type},
				            {"is_balancing", type logical},
				            {"depth", Int64.Type},
				            {"market", type text},
				            {"continent", type text},
				            {"region", type text},
				            {"country", type text}
				        }
				    )
				in
				    #"Set column types"

	annotation PBI_ResultType = Table

