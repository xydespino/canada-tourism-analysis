	column 'Year Month'
		lineageTag: 03286896-c1aa-4e69-ad1b-7e9c15210687
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]

		annotation SummarizationSetBy = Automatic

	column 'Month Start'
		formatString: General Date
		lineageTag: 472cc31b-e2b7-41b0-81cb-68a0299d80fb
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Start]

		annotation SummarizationSetBy = Automatic

	partition dim_date = calculated
		mode: import
		source =
				
				/* Full calendar years around the data: time intelligence needs complete years */
				VAR CalendarStart = DATE ( YEAR ( MIN ( fact_country[date] ) ), 1, 1 )
				VAR CalendarEnd   = DATE ( YEAR ( MAX ( fact_country[date] ) ), 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( CalendarStart, CalendarEnd ),     /* one row per day */
				        "Year",         YEAR ( [Date] ),
				        "Quarter",      "Q" & QUARTER ( [Date] ),
				        "Month Number", MONTH ( [Date] ),            /* used to sort Month */
				        "Month",        FORMAT ( [Date], "mmm" ),
				        "Year Month",   FORMAT ( [Date], "yyyy-mm" ),
				        "Month Start",  DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 )
				    )

	annotation PBI_Id = 09f84e35c3cc42f887df8f804947c9c2

